<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:strokeColor="@color/color_border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/color_surface_2"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Completion Checkbox on the left -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_complete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:buttonTint="@color/color_emerald"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Week Number Badge Pill -->
        <TextView
            android:id="@+id/tv_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEEK 1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_badge_pill_rose"
            android:backgroundTint="@color/color_primary_dim"
            style="@style/TextAppearance_AiCareer_Mono_Small"
            android:textColor="@color/color_primary_bright"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/cb_complete" />

        <!-- Milestone Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kotlin Coroutines &amp; Flow"
            style="@style/TextAppearance_AiCareer_Title_Medium"
            android:textColor="@color/color_text_primary"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_step"
            app:layout_constraintStart_toEndOf="@id/cb_complete"
            app:layout_constraintEnd_toStartOf="@id/iv_status_icon" />

        <!-- Chips Row: Resources Count & Estimated Hours -->
        <LinearLayout
            android:id="@+id/ll_chips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toEndOf="@id/cb_complete"
            app:layout_constraintEnd_toStartOf="@id/iv_status_icon">

            <!-- Resources Chip -->
            <TextView
                android:id="@+id/tv_resources_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 Resources"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_badge_pill_rose"
                android:backgroundTint="@color/color_cyan_dim"
                style="@style/TextAppearance_AiCareer_Label_Small"
                android:textColor="@color/color_cyan"
                android:layout_marginEnd="8dp" />

            <!-- Estimated Hours Chip -->
            <TextView
                android:id="@+id/tv_estimated_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 hrs"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_badge_pill_rose"
                android:backgroundTint="@color/color_gold_dim"
                style="@style/TextAppearance_AiCareer_Label_Small"
                android:textColor="@color/color_gold" />

        </LinearLayout>

        <!-- Trailing Progress State Icon (Locked/Available/Done) -->
        <ImageView
            android:id="@+id/iv_status_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/color_text_secondary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
