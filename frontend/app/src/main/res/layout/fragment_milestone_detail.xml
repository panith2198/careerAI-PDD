<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- Spacer to push content down below the sticky toolbar overlay -->
            <View
                android:id="@+id/v_spacing"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Phase + Week Badge Pill -->
            <TextView
                android:id="@+id/badge_phase_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHASE 1 • WEEKS 1-4"
                android:background="@drawable/bg_milestone_badge"
                style="@style/TextAppearance_AiCareer_Mono_Small"
                android:textColor="@color/color_primary_bright"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/v_spacing"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Kotlin Illustration Container on the right -->
            <FrameLayout
                android:id="@+id/fl_illustration_container"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_icon_button_glass"
                android:backgroundTint="@color/color_primary_dim"
                app:layout_constraintTop_toTopOf="@id/tv_milestone_title"
                app:layout_constraintBottom_toBottomOf="@id/tv_milestone_desc"
                app:layout_constraintEnd_toEndOf="parent">
                
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_kotlin" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_milestone_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Kotlin Coroutines &amp; Flow"
                style="@style/TextAppearance_AiCareer_Headline_Large"
                android:textColor="@color/color_text_primary"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/badge_phase_week"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/fl_illustration_container" />

            <!-- Description -->
            <TextView
                android:id="@+id/tv_milestone_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Master asynchronous streams, structured concurrency scopes, context parameters, and unit testing frameworks."
                style="@style/TextAppearance_AiCareer_Body_Medium"
                android:textColor="@color/color_text_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_milestone_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/fl_illustration_container" />

            <!-- Recommended Study Resources Header -->
            <TextView
                android:id="@+id/tv_resources_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECOMMENDED STUDY RESOURCES"
                style="@style/TextAppearance_AiCareer_Label_Small"
                android:textColor="@color/color_cyan"
                android:layout_marginTop="32dp"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_milestone_desc"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Resource List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_resources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tv_resources_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_resource" />

            <!-- Portfolio Project Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_project"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/color_border_violet"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/color_surface_2"
                app:layout_constraintTop_toBottomOf="@id/rv_resources"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Rocket Icon -->
                    <FrameLayout
                        android:id="@+id/fl_project_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_button_glass"
                        android:backgroundTint="@color/color_primary_dim"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_rocket"
                            app:tint="@color/color_primary_bright" />
                    </FrameLayout>

                    <!-- Text Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/fl_project_icon"
                        app:layout_constraintEnd_toStartOf="@id/iv_project_chevron">

                        <TextView
                            android:id="@+id/tv_project_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PORTFOLIO MILESTONE PROJECT"
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textSize="9sp"
                            android:textColor="@color/color_primary_bright" />

                        <TextView
                            android:id="@+id/tv_project_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Build a Dynamic Async Search App"
                            style="@style/TextAppearance_AiCareer_Title_Medium"
                            android:textColor="@color/color_text_primary"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tv_project_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Apply your concurrency and flow knowledge by building a dynamic stock indexing app. Implement custom debounce operators, lifecycle caching, and Room persistence bounds."
                            style="@style/TextAppearance_AiCareer_Body_Small"
                            android:textColor="@color/color_text_secondary"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_project_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/color_text_secondary"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Checkpoint Quiz CTA Button -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_checkpoint"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_resource_card"
                android:backgroundTint="@color/color_surface_3"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/cv_project"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_quiz_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_assessment_check"
                    app:tint="@color/color_primary_bright"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Take Checkpoint Quiz"
                    style="@style/TextAppearance_AiCareer_Title_Medium"
                    android:textColor="@color/color_text_primary"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_quiz_icon" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/color_text_secondary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Complete Button -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_complete"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_resource_card"
                android:backgroundTint="@color/color_emerald"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/btn_checkpoint"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:id="@+id/iv_complete_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/color_surface_1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_complete_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mark Milestone Complete"
                    style="@style/TextAppearance_AiCareer_Title_Medium"
                    android:textColor="@color/color_surface_1"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_complete_icon" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/color_surface_1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Fading Toolbar Overlay with background grid design and square back button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar_grid"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="@drawable/bg_icon_button_glass"
            android:src="@drawable/ic_back"
            android:contentDescription="Go back"
            app:tint="@color/color_text_primary"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kotlin Coroutines &amp; Flow"
            style="@style/TextAppearance_AiCareer_Title_Medium"
            android:textColor="@color/color_text_primary"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:alpha="0.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
