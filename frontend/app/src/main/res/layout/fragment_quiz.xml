<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_quiz_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="720dp"
        android:paddingStart="20dp"
        android:paddingTop="30dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_quiz"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:progress="20"
            app:indicatorColor="#8B5CF6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:trackColor="#24203B"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/tv_question_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="QUESTION 1 OF 5"
            android:textColor="#A855F7"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pb_quiz" />

        <LinearLayout
            android:id="@+id/timer_container"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_quiz_timer"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="14dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_question_num"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_question_num">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_quiz_timer" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="30s"
                android:textColor="#10B981"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/question_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_quiz_question_card"
            android:minHeight="174dp"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/timer_container">

            <ImageView
                android:id="@+id/iv_question_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_quiz_question_icon"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_quiz_question"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="4dp"
                android:text="Which Coroutine Dispatcher should be used for disk or network bound task flows?"
                android:textColor="#F8F7FF"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_question_icon" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/btn_option_1"
            style="@style/Widget_AiCareer_QuizOption"
            android:layout_marginTop="18dp"
            android:text="A    Dispatchers.IO"
            app:layout_constraintTop_toBottomOf="@id/question_card" />

        <Button
            android:id="@+id/btn_option_2"
            style="@style/Widget_AiCareer_QuizOption"
            android:layout_marginTop="12dp"
            android:text="B    Dispatchers.Main"
            app:layout_constraintTop_toBottomOf="@id/btn_option_1" />

        <Button
            android:id="@+id/btn_option_3"
            style="@style/Widget_AiCareer_QuizOption"
            android:layout_marginTop="12dp"
            android:text="C    Dispatchers.Default"
            app:layout_constraintTop_toBottomOf="@id/btn_option_2" />

        <Button
            android:id="@+id/btn_option_4"
            style="@style/Widget_AiCareer_QuizOption"
            android:layout_marginTop="12dp"
            android:text="D    Dispatchers.Unconfined"
            app:layout_constraintTop_toBottomOf="@id/btn_option_3" />

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_quiz_submit"
            android:drawableEnd="@drawable/ic_quiz_arrow"
            android:drawablePadding="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="20dp"
            android:text="Next Question"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            app:backgroundTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_option_4" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
