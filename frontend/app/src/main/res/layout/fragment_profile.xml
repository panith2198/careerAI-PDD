<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient"
    android:importantForAutofill="noExcludeDescendants">

    <!-- Collapsing Header with Digital Grid Pattern Overlay and glowing violet/cyan gradient backgrounds -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/color_surface_1">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/color_surface_1"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <!-- Background Gradient -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_profile_header_gradient"
                app:layout_collapseMode="parallax" />

            <!-- Digital Grid Pattern Overlay -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_grid"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax" />

            <!-- Glowing Ambient Gradient Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_glow"
                app:layout_collapseMode="parallax" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_icon_button_glass"
                        android:src="@drawable/ic_back"
                        android:contentDescription="Go back"
                        app:tint="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/tv_toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="My Smart Profile"
                        style="@style/TextAppearance_AiCareer_Title_Large"
                        android:textColor="@color/color_text_primary"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btn_settings"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_icon_button_glass"
                        android:src="@drawable/ic_system_gear"
                        android:contentDescription="Settings"
                        app:tint="@color/color_text_primary" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:behavior_overlapTop="48dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="80dp">

            <!-- SECTION 1: Dynamic User Profile Identity Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_identity_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/color_surface_2"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Avatar Card Frame with Violet Glowing ring and Status dot -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_avatar_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cv_avatar_frame"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            app:cardCornerRadius="42dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/color_primary_bright"
                            app:strokeWidth="2.5dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@color/color_surface_3"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance_Circle" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Green Active Status dot -->
                        <View
                            android:id="@+id/view_status_dot"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_pulse_dot_cyan"
                            android:backgroundTint="@color/color_emerald"
                            app:layout_constraintBottom_toBottomOf="@id/cv_avatar_frame"
                            app:layout_constraintEnd_toEndOf="@id/cv_avatar_frame"
                            android:layout_margin="2dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Profile CTA stack: Edit Profile & Free Tier Badge -->
                    <LinearLayout
                        android:id="@+id/ll_profile_actions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:gravity="center_vertical">

                        <!-- Edit Profile Outline CTA -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tv_profile_edit_cta"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Edit Profile"
                            android:textSize="11sp"
                            android:textColor="@color/color_text_primary"
                            app:strokeColor="@color/color_border"
                            app:strokeWidth="1dp"
                            app:icon="@drawable/ic_edit"
                            app:iconSize="12dp"
                            app:iconTint="@color/color_text_secondary"
                            app:cornerRadius="18dp"
                            android:layout_marginEnd="6dp"
                            android:paddingHorizontal="10dp" />

                        <!-- Free Tier Pill Badge -->
                        <LinearLayout
                            android:id="@+id/ll_tier_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_button_glass"
                            android:paddingHorizontal="10dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/color_text_secondary"
                                android:layout_marginEnd="4dp"/>

                            <TextView
                                android:id="@+id/tv_tier"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Free Tier"
                                style="@style/TextAppearance_AiCareer_Mono_Small"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- User Name -->
                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Eswar"
                        style="@style/TextAppearance_AiCareer_Headline_Large"
                        android:textColor="@color/color_text_primary"
                        app:layout_constraintTop_toBottomOf="@id/cl_avatar_container"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- User Role -->
                    <TextView
                        android:id="@+id/tv_role"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Student"
                        style="@style/TextAppearance_AiCareer_Title_Medium"
                        android:textColor="@color/color_primary_bright"
                        app:layout_constraintTop_toBottomOf="@id/tv_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Degree • City Status subtext -->
                    <TextView
                        android:id="@+id/tv_meta_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="BTECH • Bengaluru (HYBRID)"
                        style="@style/TextAppearance_AiCareer_Body_Small"
                        android:textColor="@color/color_text_tertiary"
                        app:layout_constraintTop_toBottomOf="@id/tv_role"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Horizontal separator divider -->
                    <View
                        android:id="@+id/divider_profile"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_divider"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_meta_info" />

                    <!-- Detailed 2-Column Table Grid -->
                    <GridLayout
                        android:id="@+id/gl_profile_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/divider_profile">

                        <!-- Row 1 Col 1: Institution -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp"
                            android:layout_marginEnd="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Institution"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary" />

                            <TextView
                                android:id="@+id/tv_profile_college"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Unspecified"
                                style="@style/TextAppearance_AiCareer_Title_Medium"
                                android:textColor="@color/color_text_primary"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Row 1 Col 2: Expected Salary -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expected"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary" />

                            <TextView
                                android:id="@+id/tv_profile_salary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12 LPA"
                                style="@style/TextAppearance_AiCareer_Title_Medium"
                                android:textColor="@color/color_cyan"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Row 2 Col 1: Specialization -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp"
                            android:layout_marginEnd="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Specialization"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary" />

                            <TextView
                                android:id="@+id/tv_profile_field"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Computer Science &amp; Engineering"
                                style="@style/TextAppearance_AiCareer_Title_Medium"
                                android:textColor="@color/color_text_primary"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Row 2 Col 2: LinkedIn Link -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_linkedin"
                                    android:layout_marginEnd="4dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="LinkedIn"
                                    style="@style/TextAppearance_AiCareer_Label_Small"
                                    android:textColor="@color/color_text_tertiary" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_profile_linkedin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="linkedin.com/in/eswar"
                                style="@style/TextAppearance_AiCareer_Body_Small"
                                android:textColor="@color/color_cyan"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Row 3 Col 1: Class Cohort -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Class Cohort"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary" />

                            <TextView
                                android:id="@+id/tv_profile_cohort"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2024"
                                style="@style/TextAppearance_AiCareer_Title_Medium"
                                android:textColor="@color/color_text_primary"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Row 3 Col 2: GitHub Link -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_github"
                                    android:layout_marginEnd="4dp"
                                    app:tint="@color/color_text_secondary"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="GitHub"
                                    style="@style/TextAppearance_AiCareer_Label_Small"
                                    android:textColor="@color/color_text_tertiary" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_profile_github"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="github.com/eswar"
                                style="@style/TextAppearance_AiCareer_Body_Small"
                                android:textColor="@color/color_cyan"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </GridLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: Dynamic User Skills Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_skills_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/color_surface_2"
                app:layout_constraintTop_toBottomOf="@id/card_identity_profile">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Skills Proficiency"
                            style="@style/TextAppearance_AiCareer_Headline_Medium"
                            android:textColor="@color/color_text_primary"
                            android:layout_alignParentStart="true" />

                        <!-- EDIT SKILLS / Manage Skills CTA -->
                        <LinearLayout
                            android:id="@+id/ll_manage_skills_cta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <TextView
                                android:id="@+id/tv_skills_manage_cta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Manage Skills"
                                style="@style/TextAppearance_AiCareer_Mono_Small"
                                android:textColor="@color/color_cyan"
                                android:layout_marginEnd="4dp" />

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="@color/color_cyan"/>
                        </LinearLayout>

                    </RelativeLayout>

                    <!-- Placeholder list for dynamically loaded skill progress bar item cards -->
                    <LinearLayout
                        android:id="@+id/ll_skills_bars_holder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Dashed Glassmorphic shortcut add button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_skill_shortcut"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Add Skill"
                        android:textColor="@color/color_text_secondary"
                        app:icon="@drawable/ic_plus"
                        app:iconTint="@color/color_primary_bright"
                        app:iconSize="14dp"
                        app:strokeColor="@color/color_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="24dp"
                        android:backgroundTint="@color/color_surface_3"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 3: Bottom grid horizontal cards row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/card_skills_summary">

                <!-- 1. Education bottom card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/color_surface_2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/color_primary_muted"
                            app:strokeWidth="0dp"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_education"
                                app:tint="@color/color_primary_bright"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Education"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary"
                                android:textSize="10sp"/>

                            <TextView
                                android:id="@+id/tv_bottom_edu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BTECH"
                                style="@style/TextAppearance_AiCareer_Title_Medium"
                                android:textColor="@color/color_text_primary"
                                android:textSize="13sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Computer Science"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Cohort bottom card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/color_surface_2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/color_surface_3"
                            app:strokeWidth="0dp"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/color_cyan"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cohort"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary"
                                android:textSize="10sp"/>

                            <TextView
                                android:id="@+id/tv_bottom_cohort"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2024"
                                style="@style/TextAppearance_AiCareer_Title_Medium"
                                android:textColor="@color/color_text_primary"
                                android:textSize="13sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Batch"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Placement bottom card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/color_surface_2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/color_emerald_dim"
                            app:strokeWidth="0dp"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_trend_up"
                                app:tint="@color/color_emerald"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expected"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary"
                                android:textSize="10sp"/>

                            <TextView
                                android:id="@+id/tv_bottom_salary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12 LPA"
                                style="@style/TextAppearance_AiCareer_Title_Medium"
                                android:textColor="@color/color_text_primary"
                                android:textSize="13sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Placement"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
