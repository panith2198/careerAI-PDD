<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="8dp"
    android:importantForAutofill="noExcludeDescendants"
    app:strokeColor="@color/color_border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/color_surface_2"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row (Logo, Name, Exp, More Options) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Tech Icon Wrapper -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tech_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/color_surface_3"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/iv_tech_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ai_sparkle"
                    app:tint="@color/color_cyan" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Title & declared level block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_tech_icon"
                app:layout_constraintEnd_toStartOf="@id/badge_priority">

                <TextView
                    android:id="@+id/tv_skill_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Python"
                    style="@style/TextAppearance_AiCareer_Title_Large"
                    android:textColor="@color/color_text_primary" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADVANCED"
                    style="@style/TextAppearance_AiCareer_Label_Small"
                    android:textColor="@color/color_cyan"
                    android:layout_marginTop="2dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Experience Badge -->
            <TextView
                android:id="@+id/badge_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5 YRS EXP"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_badge_pill_rose"
                android:backgroundTint="@color/color_cyan_dim"
                style="@style/TextAppearance_AiCareer_Mono_Small"
                android:textColor="@color/color_cyan"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_expand" />

            <!-- Three-dot option -->
            <ImageView
                android:id="@+id/iv_expand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_info"
                app:tint="@color/color_text_secondary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- 2-Row, 2-Column spacious metrics layout (avoiding squishing) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <!-- Row 1: Current Level & Years of Experience -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <!-- Col 1: Current Level -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_trend_up"
                        app:tint="@color/color_text_tertiary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURRENT LEVEL"
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textSize="9sp"
                            android:textColor="@color/color_text_secondary" />

                        <TextView
                            android:id="@+id/tv_current_level_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Novice"
                            style="@style/TextAppearance_AiCareer_Body_Small"
                            android:textColor="@color/color_text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Col 2: Years of Experience -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/color_text_tertiary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YEARS OF EXPERIENCE"
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textSize="9sp"
                            android:textColor="@color/color_text_secondary" />

                        <TextView
                            android:id="@+id/tv_years_experience_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.5"
                            style="@style/TextAppearance_AiCareer_Mono_Small"
                            android:textColor="@color/color_cyan" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 2: Required Level & Declared Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:gravity="center_vertical">

                <!-- Col 3: Required Level -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/color_text_tertiary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REQUIRED LEVEL"
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textSize="9sp"
                            android:textColor="@color/color_text_secondary" />

                        <TextView
                            android:id="@+id/tv_required_level_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Proficient"
                            style="@style/TextAppearance_AiCareer_Body_Small"
                            android:textColor="@color/color_primary_bright" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Col 4: Declared Badge (Left/Start aligned inside its weight segment) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_declared_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/color_border"
                        app:cardBackgroundColor="@color/color_surface_3">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DECLARED"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textSize="9sp"
                                android:textColor="@color/color_text_secondary"
                                android:layout_marginEnd="4dp" />

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_assessment_check"
                                app:tint="@color/color_primary_bright" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Course Recommendation Inner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ll_expandable_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/color_surface_3">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <!-- Graduation Cap Icon -->
                <ImageView
                    android:id="@+id/iv_course_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_education"
                    app:tint="@color/color_primary_bright"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <!-- Course Text Details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_course_icon"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tv_course_rec_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECOMMENDED FREE COURSE"
                        style="@style/TextAppearance_AiCareer_Label_Small"
                        android:textColor="@color/color_cyan"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_course_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Competency level is self-declared as ADVANCED."
                        style="@style/TextAppearance_AiCareer_Title_Medium"
                        android:textSize="12sp"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tv_course_provider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acquisition Source: SELF"
                        style="@style/TextAppearance_AiCareer_Body_Small"
                        android:textColor="@color/color_text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
