<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Dashboard"
        style="@style/TextAppearance_AiCareer_Headline_Large"
        android:textColor="@color/color_text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Trigger system level operations, retriever updates, and model retraining cycles."
        style="@style/TextAppearance_AiCareer_Body_Medium"
        android:textColor="@color/color_text_secondary"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Admin actions card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_admin_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        style="@style/Elevation_Card_Resting"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:layout_constraintTop_toBottomOf="@id/tv_desc">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btn_upload_kb"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Upload Knowledge Base"
                android:textAllCaps="false"
                android:textColor="@color/color_on_primary"
                android:backgroundTint="@color/color_primary" />

            <Button
                android:id="@+id/btn_retrain"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Retrain Matching Model"
                android:textAllCaps="false"
                android:textColor="@color/color_on_primary"
                android:backgroundTint="@color/color_cyan"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
