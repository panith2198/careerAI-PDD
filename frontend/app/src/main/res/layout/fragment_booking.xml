<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- Back + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="@drawable/bg_icon_button_glass"
                android:src="@drawable/ic_back"
                android:contentDescription="Go back"
                app:tint="@color/color_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Book Session"
                style="@style/TextAppearance_AiCareer_Headline_Large"
                android:textColor="@color/color_text_primary" />
        </LinearLayout>

        <!-- Mentor Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/color_surface_2"
            app:strokeColor="@color/color_border_violet"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_mentor_avatar"
                    android:layout_width="@dimen/avatar_md"
                    android:layout_height="@dimen/avatar_md"
                    android:scaleType="centerCrop"
                    android:src="@color/color_surface_3"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance_Circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tv_mentor_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Priya Sharma"
                        style="@style/TextAppearance_AiCareer_Title_Medium"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/tv_mentor_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹799/hr • ⭐ 4.9"
                        style="@style/TextAppearance_AiCareer_Mono_Small"
                        android:textColor="@color/color_primary_bright" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Day Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT A DAY"
            style="@style/TextAppearance_AiCareer_Label_Small"
            android:textColor="@color/color_text_tertiary"
            android:layout_marginBottom="10dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/ll_day_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Time Slots Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AVAILABLE TIME SLOTS"
            style="@style/TextAppearance_AiCareer_Label_Small"
            android:textColor="@color/color_cyan"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_time_slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Selected Slot Confirmation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_selected_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/color_primary_dim"
            app:strokeColor="@color/color_primary_bright"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textSize="20sp"
                    android:textColor="@color/color_primary_bright" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tv_selected_slot_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Slot"
                        style="@style/TextAppearance_AiCareer_Title_Medium"
                        android:textColor="@color/color_primary_bright" />

                    <TextView
                        android:id="@+id/tv_selected_slot_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon, 10:00 AM"
                        style="@style/TextAppearance_AiCareer_Body_Small"
                        android:textColor="@color/color_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Confirm Booking Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Confirm Booking"
            android:textAllCaps="false"
            android:textColor="@color/color_on_primary"
            app:cornerRadius="28dp"
            android:backgroundTint="@color/color_primary"
            android:enabled="false"
            android:alpha="0.5" />

        <!-- Calendar reminder hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 A calendar reminder will be added after confirmation."
            style="@style/TextAppearance_AiCareer_Body_Small"
            android:textColor="@color/color_text_tertiary"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
