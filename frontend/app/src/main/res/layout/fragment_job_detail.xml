<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_job_detail_screen">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="356dp"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:collapsedTitleTextAppearance="@style/TextAppearance_AiCareer_JobToolbar"
            app:contentScrim="#F2070716"
            app:expandedTitleTextAppearance="@style/TextAppearance_AiCareer_JobToolbarExpanded"
            app:expandedTitleMarginStart="20dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimAnimationDuration="250"
            app:titleCollapseMode="scale"
            app:titleEnabled="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bg_job_detail_hero"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.65" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="20dp"
                android:paddingTop="76dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp"
                app:layout_collapseMode="parallax">

                <ImageView
                    android:id="@+id/iv_company_logo"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:background="@drawable/bg_job_detail_logo"
                    android:contentDescription="@null"
                    android:padding="17dp"
                    android:src="@drawable/ic_job_mobile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif"
                    android:text="Mobile SDK Architect"
                    android:textColor="#FAF9FF"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_company_logo" />

                <TextView
                    android:id="@+id/tv_company_loc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:drawableStart="@drawable/ic_job_building"
                    android:drawablePadding="9dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Unicorn Labs  •  Mumbai (Onsite)"
                    android:textColor="#C2BED5"
                    android:textSize="15sp"
                    app:drawableTint="#9D99B8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_title" />

                <LinearLayout
                    android:id="@+id/ll_badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_company_loc">

                    <TextView
                        android:id="@+id/tv_match"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_job_detail_match"
                        android:drawableStart="@drawable/ic_job_trend"
                        android:drawablePadding="7dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingStart="13dp"
                        android:paddingEnd="14dp"
                        android:text="78% MATCH"
                        android:textColor="#22D3EE"
                        android:textSize="13sp"
                        app:drawableTint="#22D3EE" />

                    <TextView
                        android:id="@+id/tv_salary"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="11dp"
                        android:background="@drawable/bg_job_detail_salary"
                        android:drawableStart="@drawable/ic_job_money"
                        android:drawablePadding="7dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingStart="13dp"
                        android:paddingEnd="14dp"
                        android:text="₹18L - ₹28L/yr"
                        android:textColor="#A855F7"
                        android:textSize="13sp"
                        app:drawableTint="#A855F7" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_back"
                app:navigationIconTint="#FAF9FF"
                app:titleTextColor="#FAF9FF">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_top_save"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:backgroundTint="#33100F25"
                        app:cornerRadius="23dp"
                        app:icon="@drawable/ic_bookmark"
                        app:iconSize="21dp"
                        app:iconTint="#DAD6EA"
                        app:strokeColor="#51494372"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="12dp"
                        android:backgroundTint="#33100F25"
                        app:cornerRadius="23dp"
                        app:icon="@drawable/ic_job_share"
                        app:iconSize="21dp"
                        app:iconTint="#DAD6EA"
                        app:strokeColor="#51494372"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="92dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_job_detail_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_job_detail_icon"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_job_document"
                        app:tint="#A855F7" />

                    <TextView
                        android:id="@+id/tv_desc_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:text="Job Description"
                        android:textColor="#F8F7FF"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="55dp"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Full job description goes here..."
                    android:textColor="#B7B1D0"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/responsibilities_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_job_detail_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_job_detail_icon"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_jobs"
                        app:tint="#A855F7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:text="Key Responsibilities"
                        android:textColor="#F8F7FF"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/Widget_AiCareer_JobResponsibility"
                    android:text="Build beautiful, fluid, responsive user interfaces following premium Material Design Guidelines." />

                <TextView
                    style="@style/Widget_AiCareer_JobResponsibility"
                    android:text="Optimize application architectures for maximum speed, reliable caching, and efficient network calls." />

                <TextView
                    style="@style/Widget_AiCareer_JobResponsibility"
                    android:text="Write clean, maintainable, and thoroughly unit-tested code with high test coverage." />

                <TextView
                    style="@style/Widget_AiCareer_JobResponsibility"
                    android:text="Collaborate with product managers, designers, and backend engineers to ship high-quality features." />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_job_detail_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_skills_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Skills &amp; Match"
                    android:textColor="#F8F7FF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_skills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingHorizontal="7dp"
                    app:chipSpacingVertical="7dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#DD0E0D1F"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#403C3568"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:id="@+id/rl_tips_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/iv_ai_spark"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_ai_sparkle"
                            app:tint="#22D3EE" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="10dp"
                            android:layout_toEndOf="@id/iv_ai_spark"
                            android:text="AI Interview Tips"
                            android:textColor="#F8F7FF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_tips_arrow"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="#9D99B8" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/ll_tips_expanded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="#18181531" />

                        <TextView
                            android:id="@+id/tv_tips_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:textColor="#B7B1D0"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/ll_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:background="#F2070716"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_job_detail_apply"
            android:text="Apply Now"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="@null"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="82dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_job_detail_updates"
            android:gravity="center"
            android:text="Updates"
            android:textAllCaps="false"
            android:textColor="#A855F7"
            android:textSize="11sp"
            app:backgroundTint="@null"
            app:cornerRadius="17dp"
            app:icon="@drawable/ic_bell"
            app:iconGravity="top"
            app:iconSize="19dp"
            app:iconTint="#A855F7" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
