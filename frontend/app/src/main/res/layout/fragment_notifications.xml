<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_auth_gradient">

    <!-- Static Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notifications"
            style="@style/TextAppearance_AiCareer_Headline_Large"
            android:textColor="@color/color_text_primary"
            android:textStyle="bold" />

        <!-- Unread count badge (hidden by default, managed by VM) -->
        <TextView
            android:id="@+id/tv_unread_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:textColor="@color/color_on_primary"
            android:textSize="11sp"
            android:typeface="sans"
            android:textStyle="bold"
            android:gravity="center"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_badge_pill_rose"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <!-- Outlined Mark all read button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mark_all_read"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark all read"
            android:textColor="@color/color_text_violet"
            android:textSize="13sp"
            app:strokeColor="@color/color_border_violet"
            app:strokeWidth="1.2dp"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/color_text_violet"
            app:iconSize="14dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:cornerRadius="100dp" />
    </LinearLayout>

    <!-- Filter ChipGroup -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background"
                app:chipStrokeColor="@color/selector_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:chipIcon="@drawable/ic_grid"
                app:chipIconTint="@color/selector_chip_icon_tint"
                app:chipCornerRadius="100dp"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_jobs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jobs"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background"
                app:chipStrokeColor="@color/selector_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:chipIcon="@drawable/ic_jobs"
                app:chipIconTint="@color/selector_chip_icon_tint"
                app:chipCornerRadius="100dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_roadmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roadmap"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background"
                app:chipStrokeColor="@color/selector_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:chipIcon="@drawable/ic_roadmap"
                app:chipIconTint="@color/selector_chip_icon_tint"
                app:chipCornerRadius="100dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_ai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Tips"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background"
                app:chipStrokeColor="@color/selector_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:chipIcon="@drawable/ic_ai_sparkle"
                app:chipIconTint="@color/selector_chip_icon_tint"
                app:chipCornerRadius="100dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip_background"
                app:chipStrokeColor="@color/selector_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:chipIcon="@drawable/ic_system_gear"
                app:chipIconTint="@color/selector_chip_icon_tint"
                app:chipCornerRadius="100dp" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Thin divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider" />

    <!-- Main content area with FrameLayout to overlay empty state -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Notifications RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="80dp" />

        <!-- Loading indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/color_primary_bright"
            app:trackColor="@color/color_surface_3"
            app:trackThickness="4dp"
            android:visibility="gone" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/ll_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="48dp"
            android:visibility="gone">

            <!-- High Fidelity Glowing Bell with Sparkles -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginBottom="24dp">

                <!-- Ambient Radial Glow Halo -->
                <View
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:background="@drawable/bg_bell_glow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- The Glowing Bell -->
                <ImageView
                    android:id="@+id/iv_bell_empty"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/color_primary_bright"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:contentDescription="Bell outline" />

                <!-- Floating Count Badge "1" -->
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="1"
                    android:textColor="@color/color_on_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_pill_rose"
                    android:backgroundTint="@color/color_primary_bright"
                    app:layout_constraintTop_toTopOf="@id/iv_bell_empty"
                    app:layout_constraintEnd_toEndOf="@id/iv_bell_empty"
                    android:layout_marginTop="-4dp"
                    android:layout_marginEnd="-4dp" />

                <!-- Sparkle 1 (Top Left) -->
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/color_primary_glow"
                    android:alpha="0.8"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="32dp"
                    android:layout_marginStart="32dp" />

                <!-- Sparkle 2 (Bottom Left) -->
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/color_primary_glow"
                    android:alpha="0.6"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginBottom="36dp"
                    android:layout_marginStart="44dp" />

                <!-- Sparkle 3 (Top Right) -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/color_primary_glow"
                    android:alpha="0.9"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="28dp" />

                <!-- Sparkle 4 (Bottom Right) -->
                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/color_primary_glow"
                    android:alpha="0.7"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="44dp"
                    android:layout_marginEnd="40dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You're all caught up!"
                style="@style/TextAppearance_AiCareer_Title_Large"
                android:textColor="@color/color_text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="We'll notify you when something\nimportant arrives."
                style="@style/TextAppearance_AiCareer_Body_Medium"
                android:textColor="@color/color_text_secondary"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
