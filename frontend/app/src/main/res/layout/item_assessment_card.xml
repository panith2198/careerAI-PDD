<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#131336"
    app:strokeColor="#337C3AED"
    app:strokeWidth="1.5dp"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Glowing Rounded Logo Container on Left -->
        <FrameLayout
            android:id="@+id/layout_logo_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_confidence_badge"
            android:backgroundTint="#1D1242"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/iv_assessment_logo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_code"
                android:tint="@color/color_primary_bright"
                android:contentDescription="Topic Logo" />
        </FrameLayout>

        <!-- Title of Assessment -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kotlin Fundamentals"
            style="@style/TextAppearance_AiCareer_Title_Large"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/layout_logo_container"
            app:layout_constraintEnd_toStartOf="@id/tv_questions_count" />

        <!-- Subtitle/Description -->
        <TextView
            android:id="@+id/tv_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Test variables, control flow, functions, lambdas, and standard libraries."
            style="@style/TextAppearance_AiCareer_Body_Small"
            android:textColor="#9D99B8"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Cyan Questions Tag Pill -->
        <TextView
            android:id="@+id/tv_questions_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 Qs"
            style="@style/TextAppearance_AiCareer_Mono_Small"
            android:textColor="@color/color_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tag_cyan"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Time Limit with Icon -->
        <TextView
            android:id="@+id/tv_time_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20 mins"
            style="@style/TextAppearance_AiCareer_Mono_Small"
            android:textColor="@color/color_primary_bright"
            android:textSize="11sp"
            android:gravity="center_vertical"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="6dp"
            android:drawableTint="@color/color_primary_bright"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_desc"
            app:layout_constraintStart_toStartOf="@id/tv_title" />

        <!-- Difficulty with Chart Icon -->
        <TextView
            android:id="@+id/tv_difficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTERMEDIATE"
            style="@style/TextAppearance_AiCareer_Label_Small"
            android:textColor="@color/color_primary_bright"
            android:textSize="11sp"
            android:gravity="center_vertical"
            android:drawableStart="@drawable/ic_chart_bar"
            android:drawablePadding="6dp"
            android:drawableTint="@color/color_primary_bright"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/tv_time_limit"
            app:layout_constraintStart_toEndOf="@id/tv_time_limit" />

        <!-- Vibrant Gradient Start Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Start"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_start_button_gradient"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="end"
            app:iconTint="#FFFFFF"
            app:iconSize="14dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
