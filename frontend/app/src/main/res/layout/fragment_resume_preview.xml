<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Top Sticky TabLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface_1"
        app:elevation="4dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/color_surface_1"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabIndicatorColor="@color/color_primary_bright"
            app:tabSelectedTextColor="@color/color_primary_bright"
            app:tabTextColor="@color/color_text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF Viewer" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Parsed Data" />

        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Switchable Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 1. PDF Viewer Container -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_pdf_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="visible"
            android:fillViewport="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ll_bottom_bar">

            <LinearLayout
                android:id="@+id/ll_pdf_pages_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="16dp" />

        </androidx.core.widget.NestedScrollView>

        <!-- 2. AI Parsed Data ScrollView -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_parsed_data"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            android:fillViewport="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ll_bottom_bar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ATS Score Circular Gauge Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ats_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/color_surface_2"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ATS COMPATIBILITY SCORE"
                            style="@style/TextAppearance_AiCareer_Mono_Small"
                            android:textColor="@color/color_cyan"
                            android:layout_marginBottom="12dp" />

                        <!-- Radial Circle representation -->
                        <RelativeLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_badge_pill_rose"
                                android:backgroundTint="@color/color_cyan_dim" />

                            <TextView
                                android:id="@+id/tv_ats_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="85%"
                                android:textSize="28sp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/color_text_primary"
                                android:layout_centerInParent="true" />

                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tv_feedback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Strong match for Android positions! Highlight more Kotlin Flow keywords to hit 95%."
                            style="@style/TextAppearance_AiCareer_Body_Small"
                            android:textColor="@color/color_text_secondary"
                            android:gravity="center" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Extracted Skills Chips Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/color_surface_2"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Identified Skills"
                            style="@style/TextAppearance_AiCareer_Title_Medium"
                            android:textColor="@color/color_text_primary"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cg_extracted_skills"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacing="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AI Improvement Suggestions Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/color_surface_2"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ATS Improvement Recommendations"
                            style="@style/TextAppearance_AiCareer_Title_Medium"
                            android:textColor="@color/color_text_primary"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/ll_recommendations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Sticky Bottom Bar -->
        <LinearLayout
            android:id="@+id/ll_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/color_surface_1"
            android:paddingHorizontal="20dp"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_profile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Apply to Profile"
                android:textAllCaps="false"
                android:textColor="@color/color_on_primary"
                app:cornerRadius="26dp"
                android:backgroundTint="@color/color_primary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
