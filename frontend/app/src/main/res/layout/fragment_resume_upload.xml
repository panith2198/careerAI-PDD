<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Title Header -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resume AI Analyzer"
                style="@style/TextAppearance_AiCareer_Headline_Large"
                android:textColor="@color/color_text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Upload your resume PDF to instantly review ATS compatibility score, identified skills, and AI improvement recommendations."
                style="@style/TextAppearance_AiCareer_Body_Medium"
                android:textColor="@color/color_text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Main Interactive Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_upload_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/color_surface_2"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tv_desc">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <!-- Document Selection Icon -->
                    <ImageView
                        android:id="@+id/iv_doc_icon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_jobs"
                        app:tint="@color/color_primary_bright"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tv_upload_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drop your PDF resume here"
                        style="@style/TextAppearance_AiCareer_Title_Medium"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Supports only PDF files up to 10MB"
                        style="@style/TextAppearance_AiCareer_Label_Small"
                        android:textColor="@color/color_text_tertiary"
                        android:layout_marginBottom="24dp" />

                    <!-- Custom Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_select_file"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Select PDF File"
                        android:textAllCaps="false"
                        android:textColor="@color/color_primary_bright"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:cornerRadius="26dp"
                        app:strokeColor="@color/color_primary_bright"
                        app:strokeWidth="1.5dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Selected File Info Card (Visible after selection) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_file_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/color_surface_3"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/cv_upload_box">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_file_type_indicator"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_jobs"
                        app:tint="@color/color_rose"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/iv_file_type_indicator"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/tv_file_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="resume_senior_dev.pdf"
                            style="@style/TextAppearance_AiCareer_Title_Medium"
                            android:textColor="@color/color_text_primary"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tv_file_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.2 MB"
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textColor="@color/color_text_tertiary" />

                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upload Progress Indicator (Visible during upload) -->
            <LinearLayout
                android:id="@+id/ll_upload_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/cv_file_info">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uploading to secure vault..."
                        style="@style/TextAppearance_AiCareer_Label_Small"
                        android:textColor="@color/color_text_secondary"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:id="@+id/tv_progress_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45%"
                        style="@style/TextAppearance_AiCareer_Mono_Small"
                        android:textColor="@color/color_cyan"
                        android:layout_alignParentEnd="true" />

                </RelativeLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pb_upload"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp"
                    app:trackColor="@color/color_surface_3"
                    app:indicatorColor="@color/color_primary_bright"
                    android:progress="45" />

            </LinearLayout>

            <!-- Real-time Parsing Timeline (Visible during task extraction) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_parse_timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/color_surface_2"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/ll_upload_progress">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Parsing Progress"
                        style="@style/TextAppearance_AiCareer_Title_Medium"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginBottom="16dp" />

                    <!-- Step 1: Upload Complete -->
                    <LinearLayout
                        android:id="@+id/step_upload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/iv_step_upload_status"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_launcher_foreground"
                            app:tint="@color/color_emerald" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="File uploaded securely"
                            style="@style/TextAppearance_AiCareer_Body_Medium"
                            android:textColor="@color/color_text_primary"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                    <!-- Step 2: Semantic Extraction -->
                    <LinearLayout
                        android:id="@+id/step_extract"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ProgressBar
                            android:id="@+id/pb_step_extract_status"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/color_primary_bright" />

                        <TextView
                            android:id="@+id/tv_step_extract_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI semantic extraction..."
                            style="@style/TextAppearance_AiCareer_Body_Medium"
                            android:textColor="@color/color_text_secondary"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                    <!-- Step 3: ATS Rating -->
                    <LinearLayout
                        android:id="@+id/step_ats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_step_ats_status"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_launcher_foreground"
                            app:tint="@color/color_text_tertiary" />

                        <TextView
                            android:id="@+id/tv_step_ats_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ATS rating computation"
                            style="@style/TextAppearance_AiCareer_Body_Medium"
                            android:textColor="@color/color_text_tertiary"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ATS Score Success Badge Card (Shown upon successful extraction) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_success_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:strokeColor="@color/color_primary_bright"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/color_surface_glass_strong"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/cv_parse_timeline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMPATIBILITY RATING"
                        style="@style/TextAppearance_AiCareer_Mono_Small"
                        android:textColor="@color/color_cyan"
                        android:layout_marginBottom="8dp" />

                    <!-- Large score circle -->
                    <RelativeLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_badge_pill_rose"
                            android:backgroundTint="@color/color_primary_dim" />

                        <TextView
                            android:id="@+id/tv_ats_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="85"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/color_text_primary"
                            android:layout_centerInParent="true" />

                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Excellent Compatibility Score!"
                        style="@style/TextAppearance_AiCareer_Title_Medium"
                        android:textColor="@color/color_emerald"
                        android:layout_marginBottom="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_report"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="View Detailed Report"
                        android:textAllCaps="false"
                        android:textColor="@color/color_on_primary"
                        app:cornerRadius="26dp"
                        android:backgroundTint="@color/color_primary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
