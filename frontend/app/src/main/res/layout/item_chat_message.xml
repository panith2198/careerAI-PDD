<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- User Message Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="64dp"
        app:cardBackgroundColor="@color/color_primary"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="16dp">

        <TextView
            android:id="@+id/tv_message_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="User query details"
            style="@style/TextAppearance_AiCareer_Body_Medium"
            android:textColor="@color/color_on_primary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- AI Message Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="64dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/color_surface_2"
        style="@style/Elevation_Card_Resting"
        app:cardCornerRadius="16dp">

        <TextView
            android:id="@+id/tv_message_ai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="AI streaming career intelligence response..."
            style="@style/TextAppearance_AiCareer_Body_Medium"
            android:textColor="@color/color_text_primary" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
