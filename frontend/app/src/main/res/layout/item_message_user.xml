<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp"
    android:paddingHorizontal="4dp">

    <!-- User Message Bubble — right aligned, purple gradient -->
    <LinearLayout
        android:id="@+id/card_user_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_button_primary_gradient"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:maxWidth="280dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How do I become an Android Architect?"
            style="@style/TextAppearance_AiCareer_Body_Medium"
            android:textColor="@color/color_on_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tv_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00 PM"
            style="@style/TextAppearance_AiCareer_Label_Small"
            android:textColor="#B0FFFFFF"
            android:textSize="10sp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
