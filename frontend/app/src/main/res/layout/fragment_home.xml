<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient">

    <!-- Scrollable Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingTop="60dp"> <!-- Space for the floating toolbar -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="24dp">

                <!-- Loading Shimmer Layout -->
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <View
                            android:layout_width="180dp"
                            android:layout_height="24dp"
                            android:background="@color/color_surface_3"
                            android:layout_marginBottom="8dp" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:background="@color/color_surface_3"
                            android:layout_marginBottom="16dp" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <!-- Main Content Container -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Custom Header / Greeting Area -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toTopOf="parent">

                        <!-- User Profile Pic -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_avatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="@color/color_border_violet"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance_Circle"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <!-- Greeting text -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp"
                            app:layout_constraintTop_toTopOf="@id/iv_avatar"
                            app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
                            app:layout_constraintStart_toEndOf="@id/iv_avatar"
                            app:layout_constraintEnd_toStartOf="@id/btn_bell">

                            <TextView
                                android:id="@+id/tv_greeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Welcome Back, Eswar"
                                style="@style/TextAppearance_AiCareer_Title_Large"
                                android:textColor="@color/color_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your AI Career Dashboard Overview"
                                style="@style/TextAppearance_AiCareer_Body_Small"
                                android:textColor="@color/color_text_secondary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Notification Bell (Glass container) -->
                        <ImageView
                            android:id="@+id/btn_bell"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:padding="9dp"
                            android:background="@drawable/bg_icon_button_glass"
                            android:src="@drawable/ic_bell"
                            android:contentDescription="Notifications"
                            app:tint="@color/color_text_primary"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- AI Career Fit Compatibility Hero Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_ai_fit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="24dp"
                        app:layout_constraintTop_toBottomOf="@id/layout_header">

                        <!-- Blue/Violet Gradient Shape Frame -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_fit_card_gradient">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="20dp">

                                <TextView
                                    android:id="@+id/tv_fit_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AI CAREER FIT COMPATIBILITY"
                                    style="@style/TextAppearance_AiCareer_Label_Small"
                                    android:textColor="@color/color_primary_glow"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintStart_toStartOf="parent" />

                                <!-- Donut Chart -->
                                <com.github.mikephil.charting.charts.PieChart
                                    android:id="@+id/chart_fit_donut"
                                    android:layout_width="120dp"
                                    android:layout_height="120dp"
                                    android:layout_marginTop="16dp"
                                    app:layout_constraintTop_toBottomOf="@id/tv_fit_title"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent" />

                                <!-- Right side info panel -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginStart="20dp"
                                    app:layout_constraintTop_toTopOf="@id/chart_fit_donut"
                                    app:layout_constraintBottom_toBottomOf="@id/chart_fit_donut"
                                    app:layout_constraintStart_toEndOf="@id/chart_fit_donut"
                                    app:layout_constraintEnd_toEndOf="parent">

                                    <!-- Trend Box Icon -->
                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        app:cardCornerRadius="8dp"
                                        app:strokeWidth="0dp"
                                        app:cardBackgroundColor="#208B5CF6">
                                        <ImageView
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_trend_up"
                                            app:tint="@color/color_primary_glow" />
                                    </com.google.android.material.card.MaterialCardView>

                                    <!-- Career Target Title -->
                                    <TextView
                                        android:id="@+id/tv_target_career_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Data Analyst"
                                        style="@style/TextAppearance_AiCareer_Headline_Medium"
                                        android:textColor="@color/color_text_primary"
                                        android:textStyle="bold"
                                        android:layout_marginTop="8dp" />

                                    <!-- Subtitle -->
                                    <TextView
                                        android:id="@+id/tv_target_career_desc"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Highly compatible fit with verified skills."
                                        style="@style/TextAppearance_AiCareer_Body_Small"
                                        android:textColor="@color/color_text_secondary"
                                        android:layout_marginTop="2dp" />

                                    <!-- Index Value -->
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:layout_marginTop="10dp">
                                        <TextView
                                            android:id="@+id/tv_target_fit_val"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="95%"
                                            style="@style/TextAppearance_AiCareer_Headline_Large"
                                            android:textColor="@color/color_cyan"
                                            android:textStyle="bold" />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="INDEX SCORE"
                                            style="@style/TextAppearance_AiCareer_Label_Medium"
                                            android:textColor="@color/color_text_secondary"
                                            android:layout_marginTop="-2dp"/>
                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Top Career Matches Header -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_matches_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        app:layout_constraintTop_toBottomOf="@id/card_ai_fit">

                        <TextView
                            android:id="@+id/tv_match_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOP CAREER MATCHES"
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/btn_view_all_matches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View All ›"
                            style="@style/TextAppearance_AiCareer_Title_Small"
                            android:textColor="@color/color_primary_bright"
                            android:textStyle="bold"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- RecyclerView for Career Matches -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_career_matches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/layout_matches_header"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Dots Indicator -->
                    <LinearLayout
                        android:id="@+id/layout_dots_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/rv_career_matches"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_indicator_dot_active" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_indicator_dot_inactive" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_indicator_dot_inactive" />
                    </LinearLayout>

                    <!-- Active Learning Roadmap Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_roadmap_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:cardBackgroundColor="@color/color_surface_2"
                        app:strokeColor="@color/color_border"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="24dp"
                        app:layout_constraintTop_toBottomOf="@id/layout_dots_indicator">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <!-- Left text layout -->
                            <LinearLayout
                                android:id="@+id/ll_roadmap_texts"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/iv_roadmap_illustration">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ACTIVE LEARNING ROADMAP"
                                    style="@style/TextAppearance_AiCareer_Label_Small"
                                    android:textColor="@color/color_cyan"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_roadmap_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Become a Data Analyst in 3M"
                                    style="@style/TextAppearance_AiCareer_Headline_Small"
                                    android:textColor="@color/color_text_primary"
                                    android:textStyle="bold"
                                    android:layout_marginTop="6dp" />

                                <!-- Progress bar layout -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="16dp">

                                    <ProgressBar
                                        android:id="@+id/pb_roadmap"
                                        style="?android:attr/progressBarStyleHorizontal"
                                        android:layout_width="0dp"
                                        android:layout_height="6dp"
                                        android:layout_weight="1"
                                        android:progress="10"
                                        android:progressTint="@color/color_primary_bright"
                                        android:progressBackgroundTint="@color/color_border" />

                                    <TextView
                                        android:id="@+id/tv_roadmap_pct"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="10%"
                                        style="@style/TextAppearance_AiCareer_Mono_Small"
                                        android:textColor="@color/color_text_primary"
                                        android:layout_marginStart="12dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Roadmap mountain peak illustration graphic on right -->
                            <ImageView
                                android:id="@+id/iv_roadmap_illustration"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_marginEnd="16dp"
                                android:src="@drawable/ic_roadmap_mountain"
                                android:scaleType="fitCenter"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toTopOf="@id/btn_action_milestone"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <!-- Bottom full-width solid purple button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_action_milestone"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_margin="16dp"
                                android:text="Open Roadmap Planner"
                                android:textAllCaps="false"
                                android:textColor="@color/color_on_primary"
                                android:backgroundTint="@color/color_primary"
                                app:icon="@drawable/ic_education"
                                app:iconGravity="textStart"
                                app:iconTint="@color/color_on_primary"
                                app:cornerRadius="26dp"
                                app:layout_constraintTop_toBottomOf="@id/ll_roadmap_texts"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Navigation & Quick Access section -->
                    <TextView
                        android:id="@+id/tv_actions_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAVIGATION &amp; QUICK ACCESS"
                        style="@style/TextAppearance_AiCareer_Label_Small"
                        android:textColor="@color/color_text_primary"
                        android:textStyle="bold"
                        android:layout_marginTop="28dp"
                        app:layout_constraintTop_toBottomOf="@id/card_roadmap_progress"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Quick access 2x2 Grid redesign -->
                    <GridLayout
                        android:id="@+id/gl_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false"
                        app:layout_constraintTop_toBottomOf="@id/tv_actions_label"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Item 1: Explore Careers (Neon blue) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_explore_careers"
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="6dp"
                            app:cardBackgroundColor="@color/color_surface_2"
                            app:strokeColor="#3022D3EE"
                            app:strokeWidth="1dp"
                            app:cardCornerRadius="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardCornerRadius="10dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="#2022D3EE">
                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_compass"
                                        app:tint="@color/color_cyan" />
                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Explore Careers"
                                    style="@style/TextAppearance_AiCareer_Title_Small"
                                    android:textColor="@color/color_text_primary"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Item 2: Learning Resources (Neon green) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_chat_ai"
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="6dp"
                            app:cardBackgroundColor="@color/color_surface_2"
                            app:strokeColor="#3010B981"
                            app:strokeWidth="1dp"
                            app:cardCornerRadius="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardCornerRadius="10dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="#2010B981">
                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_chat"
                                        app:tint="@color/color_emerald" />
                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AI Navigator"
                                    style="@style/TextAppearance_AiCareer_Title_Small"
                                    android:textColor="@color/color_text_primary"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Item 3: Assessments & Tests (Neon pink) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_assessments"
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="6dp"
                            app:cardBackgroundColor="@color/color_surface_2"
                            app:strokeColor="#30F43F5E"
                            app:strokeWidth="1dp"
                            app:cardCornerRadius="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardCornerRadius="10dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="#20F43F5E">
                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_trend_up"
                                        app:tint="@color/color_rose" />
                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Assessments"
                                    style="@style/TextAppearance_AiCareer_Title_Small"
                                    android:textColor="@color/color_text_primary"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Item 4: Saved Careers (Neon violet) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_jobs"
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="6dp"
                            app:cardBackgroundColor="@color/color_surface_2"
                            app:strokeColor="#308B5CF6"
                            app:strokeWidth="1dp"
                            app:cardCornerRadius="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardCornerRadius="10dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="#208B5CF6">
                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_star"
                                        app:tint="@color/color_primary_bright" />
                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Jobs Portal"
                                    style="@style/TextAppearance_AiCareer_Title_Small"
                                    android:textColor="@color/color_text_primary"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </GridLayout>

                    <!-- Recent Jobs matching list -->
                    <TextView
                        android:id="@+id/tv_recent_jobs_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECENT MATCHING JOBS"
                        style="@style/TextAppearance_AiCareer_Label_Small"
                        android:textColor="@color/color_text_secondary"
                        android:textStyle="bold"
                        android:layout_marginTop="28dp"
                        app:layout_constraintTop_toBottomOf="@id/gl_actions"
                        app:layout_constraintStart_toStartOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_recent_jobs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/tv_recent_jobs_label"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Top Toolbar (Transparent by default) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_floating"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_toolbar_title_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                style="@style/TextAppearance_AiCareer_Title_Large"
                android:textColor="@color/color_text_primary"
                android:textStyle="bold"
                android:alpha="0.0"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/btn_bell_toolbar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:alpha="0.0"
                android:background="@drawable/bg_icon_button_glass"
                android:src="@drawable/ic_bell"
                android:contentDescription="Notifications"
                app:tint="@color/color_text_primary"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

</FrameLayout>
