<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:strokeColor="@color/color_border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/color_surface_2"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Leading Checkbox Indicator -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_complete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:buttonTint="@color/color_emerald"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Milestone Content -->
        <LinearLayout
            android:id="@+id/ll_milestone_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/cb_complete"
            app:layout_constraintEnd_toStartOf="@id/iv_status_icon">

            <TextView
                android:id="@+id/tv_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEEK 1"
                style="@style/TextAppearance_AiCareer_Label_Small"
                android:textColor="@color/color_primary_bright" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kotlin Fundamentals &amp; Coroutines"
                style="@style/TextAppearance_AiCareer_Title_Medium"
                android:textColor="@color/color_text_primary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Master concurrency, asynchronous flows, scopes, and unit testing."
                style="@style/TextAppearance_AiCareer_Body_Small"
                android:textColor="@color/color_text_secondary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Trailing State Icon (Lock / Check / Arrow) -->
        <ImageView
            android:id="@+id/iv_status_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/color_text_tertiary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
