<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/color_surface_1"
            app:titleEnabled="false">

            <ImageView
                android:id="@+id/iv_career_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@color/color_surface_2"
                app:layout_collapseMode="parallax" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_glow"
                android:alpha="0.4"
                app:layout_collapseMode="parallax" />

            <!-- Custom Toolbar with Glass Actions and Scroll-Fade Title -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_career"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <!-- Back button (glass) -->
                    <FrameLayout
                        android:id="@+id/btn_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_icon_button_glass">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_back"
                            app:tint="@color/color_text_primary" />
                    </FrameLayout>

                    <!-- Center/Left Toolbar Title (hidden at top, fades in on scroll) -->
                    <TextView
                        android:id="@+id/tv_toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/btn_back"
                        android:layout_toStartOf="@id/btn_bookmark"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="Android Platform Architect"
                        style="@style/TextAppearance_AiCareer_Title_Medium"
                        android:textColor="@color/color_text_primary"
                        android:textStyle="bold"
                        android:alpha="0"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <!-- Bookmark button (glass) -->
                    <FrameLayout
                        android:id="@+id/btn_bookmark"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_icon_button_glass">

                        <ImageView
                            android:id="@+id/iv_bookmark"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bookmark"
                            app:tint="@color/color_text_primary" />
                    </FrameLayout>

                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_career"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android Platform Architect"
                style="@style/TextAppearance_AiCareer_Headline_Large"
                android:textColor="@color/color_text_primary"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Category badge layout -->
            <LinearLayout
                android:id="@+id/ll_category_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_title">

                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOBILE ENGINEERING"
                    style="@style/TextAppearance_AiCareer_Label_Small"
                    android:textColor="@color/color_primary_bright"
                    android:background="@drawable/bg_icon_button_glass"
                    android:backgroundTint="@color/color_primary_dim"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:textColor="@color/color_text_tertiary"
                    android:layout_marginHorizontal="8dp" />

                <TextView
                    android:id="@+id/tv_difficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADVANCED"
                    style="@style/TextAppearance_AiCareer_Label_Small"
                    android:textColor="@color/color_emerald"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Design, optimize, and steer robust system level mobile structures."
                style="@style/TextAppearance_AiCareer_Body_Medium"
                android:textColor="@color/color_text_secondary"
                android:layout_marginTop="14dp"
                android:lineSpacingMultiplier="1.3"
                app:layout_constraintTop_toBottomOf="@id/ll_category_container"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Salary Distribution Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_salary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/color_surface_1"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/color_border"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tv_description">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:id="@+id/fl_salary_icon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_button_glass"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_jobs"
                                app:tint="@color/color_primary_bright" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/fl_salary_icon"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Annual Salary Distribution"
                                style="@style/TextAppearance_AiCareer_Title_Small"
                                android:textColor="@color/color_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(₹ in LPA)"
                                style="@style/TextAppearance_AiCareer_Label_Small"
                                android:textColor="@color/color_text_tertiary"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <!-- Glass spinner drop label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="India  ▼"
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textColor="@color/color_text_secondary"
                            android:background="@drawable/bg_icon_button_glass"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp" />

                    </RelativeLayout>

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chart_salary"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="16dp" />

                    <!-- Info text -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/color_text_tertiary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Data represents market range based on experience and location."
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textColor="@color/color_text_tertiary"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Skills Competencies Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_skills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/color_surface_1"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/color_border"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_salary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:id="@+id/fl_skills_icon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_button_glass"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_code"
                                app:tint="@color/color_cyan" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/fl_skills_icon"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:text="Required Skills Competency"
                            style="@style/TextAppearance_AiCareer_Title_Small"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="View all  ›"
                            style="@style/TextAppearance_AiCareer_Label_Medium"
                            android:textColor="@color/color_primary_bright"
                            android:textStyle="bold" />

                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_skills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Growth Timeline Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_growth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/color_surface_1"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/color_border"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_skills">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="5-YEAR MARKET DEMAND GROWTH"
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textColor="@color/color_primary_bright"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="India  ▼"
                            style="@style/TextAppearance_AiCareer_Label_Small"
                            android:textColor="@color/color_text_secondary"
                            android:background="@drawable/bg_icon_button_glass"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp" />

                    </RelativeLayout>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_growth"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Career Action Command Centers Header -->
            <TextView
                android:id="@+id/tv_actions_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAREER ACTION COMMAND CENTERS"
                style="@style/TextAppearance_AiCareer_Label_Small"
                android:textColor="@color/color_text_tertiary"
                android:layout_marginTop="28dp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/card_growth"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Generate AI Learning Roadmap Button Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_roadmap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/color_surface_1"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/color_border"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tv_actions_header">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_button_glass">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_people"
                            app:tint="@color/color_primary_bright" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Generate AI Learning Roadmap"
                            style="@style/TextAppearance_AiCareer_Title_Small"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Personalized roadmap to upskill and grow"
                            style="@style/TextAppearance_AiCareer_Body_Small"
                            android:textColor="@color/color_text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/color_primary_bright" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Take Capability Assessment Button Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_assessment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/color_surface_1"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/color_border"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/btn_roadmap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_button_glass">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_assessment_check"
                            app:tint="@color/color_cyan" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Take Capability Assessment"
                            style="@style/TextAppearance_AiCareer_Title_Small"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Evaluate your skills and strengths"
                            style="@style/TextAppearance_AiCareer_Body_Small"
                            android:textColor="@color/color_text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/color_cyan" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- View Path Milestones Button Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_career_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/color_surface_1"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/color_border"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/btn_assessment">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_button_glass">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_roadmap"
                            app:tint="@color/color_primary_glow" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="View Path Milestones"
                            style="@style/TextAppearance_AiCareer_Title_Small"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Track your career progress"
                            style="@style/TextAppearance_AiCareer_Body_Small"
                            android:textColor="@color/color_text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/color_primary_glow" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Find Matching Tech Jobs Button Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_find_jobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/color_surface_1"
                app:strokeWidth="1.2dp"
                app:strokeColor="@color/color_border"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/btn_career_path"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_button_glass">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_jobs"
                            app:tint="@color/color_text_violet" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Find Matching Tech Jobs"
                            style="@style/TextAppearance_AiCareer_Title_Small"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Explore jobs that match your skills"
                            style="@style/TextAppearance_AiCareer_Body_Small"
                            android:textColor="@color/color_text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/color_text_violet" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
