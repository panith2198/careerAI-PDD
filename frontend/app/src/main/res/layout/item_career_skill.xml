<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">

    <!-- Skill Icon (Glass Box) -->
    <FrameLayout
        android:id="@+id/fl_skill_icon_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_button_glass"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/iv_skill_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_code"
            app:tint="@color/color_text_primary" />
    </FrameLayout>

    <!-- Skill Title -->
    <TextView
        android:id="@+id/tv_skill_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kotlin Programming"
        style="@style/TextAppearance_AiCareer_Title_Small"
        android:textColor="@color/color_text_primary"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/fl_skill_icon_container"
        app:layout_constraintEnd_toStartOf="@id/tv_proficiency_val" />

    <!-- Skill Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_proficiency"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="12dp"
        android:progress="80"
        android:progressTint="@color/color_primary_bright"
        android:progressBackgroundTint="@color/color_border"
        app:layout_constraintTop_toBottomOf="@id/tv_skill_name"
        app:layout_constraintStart_toEndOf="@id/fl_skill_icon_container"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Skill Percentage Value -->
    <TextView
        android:id="@+id/tv_proficiency_val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="80%"
        style="@style/TextAppearance_AiCareer_Mono_Small"
        android:textColor="@color/color_cyan"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
