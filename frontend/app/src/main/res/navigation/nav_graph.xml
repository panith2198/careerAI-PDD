<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <!-- Primary Bottom Navigation Tabs -->

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.aicareer.navigator.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_assessment"
            app:destination="@id/navigation_assessment" />
        <action
            android:id="@+id/action_home_to_roadmap"
            app:destination="@id/navigation_roadmap" />
        <action
            android:id="@+id/action_home_to_resume_upload"
            app:destination="@id/navigation_resume_upload" />
        <action
            android:id="@+id/action_home_to_mentor"
            app:destination="@id/navigation_mentor" />
    </fragment>

    <fragment
        android:id="@+id/navigation_career"
        android:name="com.aicareer.navigator.ui.career.CareerFragment"
        android:label="Career Hub"
        tools:layout="@layout/fragment_career">
        <action
            android:id="@+id/action_career_to_detail"
            app:destination="@id/navigation_career_detail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/navigation_chat"
        android:name="com.aicareer.navigator.ui.rag.RagChatFragment"
        android:label="AI Chat"
        tools:layout="@layout/fragment_chat" />

    <fragment
        android:id="@+id/navigation_jobs"
        android:name="com.aicareer.navigator.ui.jobs.JobsFragment"
        android:label="Jobs"
        tools:layout="@layout/fragment_jobs">
        <action
            android:id="@+id/action_jobs_to_detail"
            app:destination="@id/navigation_job_detail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_jobs_to_saved"
            app:destination="@id/navigation_saved_jobs" />
        <action
            android:id="@+id/action_jobs_to_applications"
            app:destination="@id/navigation_applications" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.aicareer.navigator.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/navigation_settings"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_profile_to_resume_upload"
            app:destination="@id/navigation_resume_upload" />
        <action
            android:id="@+id/action_profile_to_mentor"
            app:destination="@id/navigation_mentor" />
        <action
            android:id="@+id/action_profile_to_skills"
            app:destination="@id/navigation_skills" />
        <action
            android:id="@+id/action_profile_to_edit"
            app:destination="@id/navigation_edit_profile"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Secondary Destinations (Detail screens) -->

    <fragment
        android:id="@+id/navigation_career_detail"
        android:name="com.aicareer.navigator.ui.career.CareerDetailFragment"
        android:label="Career Detail"
        tools:layout="@layout/fragment_career_detail">
        <action
            android:id="@+id/action_detail_to_path"
            app:destination="@id/navigation_career_path" />
        <action
            android:id="@+id/action_detail_to_assessment"
            app:destination="@id/navigation_assessment" />
        <action
            android:id="@+id/action_detail_to_roadmap"
            app:destination="@id/navigation_roadmap" />
        <action
            android:id="@+id/action_detail_to_recommend"
            app:destination="@id/navigation_career_recommend" />
    </fragment>

    <fragment
        android:id="@+id/navigation_career_path"
        android:name="com.aicareer.navigator.ui.career.CareerPathFragment"
        android:label="Career Path"
        tools:layout="@layout/fragment_career_path" />

    <fragment
        android:id="@+id/navigation_assessment"
        android:name="com.aicareer.navigator.ui.assessment.AssessmentListFragment"
        android:label="Assessment"
        tools:layout="@layout/fragment_assessment_list">
        <action
            android:id="@+id/action_assessment_to_quiz"
            app:destination="@id/navigation_quiz" />
    </fragment>

    <fragment
        android:id="@+id/navigation_quiz"
        android:name="com.aicareer.navigator.ui.assessment.QuizFragment"
        android:label="Quiz"
        tools:layout="@layout/fragment_quiz">
        <action
            android:id="@+id/action_quiz_to_result"
            app:destination="@id/navigation_result"
            app:popUpTo="@id/navigation_assessment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/navigation_result"
        android:name="com.aicareer.navigator.ui.assessment.ResultFragment"
        android:label="Result"
        tools:layout="@layout/fragment_result">
        <action
            android:id="@+id/action_result_to_gap"
            app:destination="@id/navigation_skill_gap" />
    </fragment>

    <fragment
        android:id="@+id/navigation_roadmap"
        android:name="com.aicareer.navigator.ui.roadmap.RoadmapFragment"
        android:label="Roadmap"
        tools:layout="@layout/fragment_roadmap">
        <action
            android:id="@+id/action_roadmap_to_detail"
            app:destination="@id/navigation_milestone_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_job_detail"
        android:name="com.aicareer.navigator.ui.jobs.JobDetailFragment"
        android:label="Job Detail"
        tools:layout="@layout/fragment_job_detail" />

    <fragment
        android:id="@+id/navigation_resume_upload"
        android:name="com.aicareer.navigator.ui.resume.ResumeUploadFragment"
        android:label="Resume Upload"
        tools:layout="@layout/fragment_resume_upload">
        <action
            android:id="@+id/action_upload_to_preview"
            app:destination="@id/navigation_resume_preview" />
    </fragment>

    <fragment
        android:id="@+id/navigation_mentor"
        android:name="com.aicareer.navigator.ui.mentor.MentorFragment"
        android:label="Mentors"
        tools:layout="@layout/fragment_mentor">
        <action
            android:id="@+id/action_mentor_to_detail"
            app:destination="@id/navigation_mentor_detail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.aicareer.navigator.ui.profile.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/navigation_career_recommend"
        android:name="com.aicareer.navigator.ui.career.CareerRecommendFragment"
        android:label="Recommendations"
        tools:layout="@layout/fragment_career_recommend" />

    <fragment
        android:id="@+id/navigation_skill_gap"
        android:name="com.aicareer.navigator.ui.assessment.SkillGapFragment"
        android:label="Skill Gap Analysis"
        tools:layout="@layout/fragment_skill_gap" />

    <fragment
        android:id="@+id/navigation_milestone_detail"
        android:name="com.aicareer.navigator.ui.roadmap.MilestoneDetailFragment"
        android:label="Milestone Detail"
        tools:layout="@layout/fragment_milestone_detail">
        <action
            android:id="@+id/action_detail_to_roadmap"
            app:destination="@id/navigation_roadmap" />
    </fragment>

    <fragment
        android:id="@+id/navigation_resume_preview"
        android:name="com.aicareer.navigator.ui.resume.ResumePreviewFragment"
        android:label="Resume Preview"
        tools:layout="@layout/fragment_resume_preview">
        <action
            android:id="@+id/action_preview_to_profile"
            app:destination="@id/navigation_profile" />
    </fragment>

    <fragment
        android:id="@+id/navigation_skills"
        android:name="com.aicareer.navigator.ui.profile.SkillsFragment"
        android:label="Skills Profile"
        tools:layout="@layout/fragment_skills">
        <action
            android:id="@+id/action_skills_to_assessment"
            app:destination="@id/navigation_assessment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_mentor_detail"
        android:name="com.aicareer.navigator.ui.mentor.MentorDetailFragment"
        android:label="Mentor Profile"
        tools:layout="@layout/fragment_mentor_detail">
        <action
            android:id="@+id/action_detail_to_booking"
            app:destination="@id/navigation_booking"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/navigation_booking"
        android:name="com.aicareer.navigator.ui.mentor.BookingFragment"
        android:label="Book Session"
        tools:layout="@layout/fragment_booking" />

    <fragment
        android:id="@+id/navigation_analytics"
        android:name="com.aicareer.navigator.ui.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.aicareer.navigator.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_admin"
        android:name="com.aicareer.navigator.ui.admin.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin" />

    <fragment
        android:id="@+id/navigation_saved_jobs"
        android:name="com.aicareer.navigator.ui.jobs.SavedJobsFragment"
        android:label="Saved Jobs"
        tools:layout="@layout/fragment_saved_jobs" />

    <fragment
        android:id="@+id/navigation_applications"
        android:name="com.aicareer.navigator.ui.jobs.ApplicationsFragment"
        android:label="My Applications"
        tools:layout="@layout/fragment_applications" />

    <fragment
        android:id="@+id/navigation_edit_profile"
        android:name="com.aicareer.navigator.ui.profile.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />
</navigation>
