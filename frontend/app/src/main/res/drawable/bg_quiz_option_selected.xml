<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="0" android:endColor="#402E1065" android:startColor="#EA17112E" />
            <stroke android:width="2dp" android:color="#A855F7" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:width="42dp"
        android:height="42dp"
        android:gravity="start|center_vertical"
        android:left="12dp">
        <shape android:shape="oval">
            <gradient android:angle="315" android:endColor="#4C1D95" android:startColor="#7C3AED" />
            <stroke android:width="1dp" android:color="#A78BFA" />
        </shape>
    </item>
</layer-list>
