<?xml version="1.0" encoding="utf-8"?>
<!-- CareerAI In-App Logo — full branded version for splash, about, headers
     Sized at 48dp standard for in-app use (scalable vector) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Arrow shaft (career growth) -->
    <path
        android:pathData="M24,8 L24,38"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="24"
                android:startY="38"
                android:endX="24"
                android:endY="8">
                <item android:offset="0.0" android:color="#FF7B2FBE" />
                <item android:offset="1.0" android:color="#FF9D4EDD" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Arrow head -->
    <path
        android:pathData="M16,18 L24,8 L32,18"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="16"
                android:startY="18"
                android:endX="32"
                android:endY="18">
                <item android:offset="0.0" android:color="#FF9D4EDD" />
                <item android:offset="1.0" android:color="#FF00D4FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- AI circuit branches -->
    <path
        android:pathData="M24,26 L14,20"
        android:strokeWidth="2"
        android:strokeColor="#00D4FF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M24,26 L34,20"
        android:strokeWidth="2"
        android:strokeColor="#00D4FF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M24,32 L12,29"
        android:strokeWidth="1.5"
        android:strokeColor="#7B2FBE"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M24,32 L36,29"
        android:strokeWidth="1.5"
        android:strokeColor="#7B2FBE"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Circuit nodes -->
    <path android:pathData="M24,8 m-3,0 a3,3 0,1 1,6 0 a3,3 0,1 1,-6 0" android:fillColor="#9D4EDD" />
    <path android:pathData="M24,26 m-2.5,0 a2.5,2.5 0,1 1,5 0 a2.5,2.5 0,1 1,-5 0" android:fillColor="#00D4FF" />
    <path android:pathData="M14,20 m-2,0 a2,2 0,1 1,4 0 a2,2 0,1 1,-4 0" android:fillColor="#00D4FF" />
    <path android:pathData="M34,20 m-2,0 a2,2 0,1 1,4 0 a2,2 0,1 1,-4 0" android:fillColor="#00D4FF" />
    <path android:pathData="M24,32 m-2,0 a2,2 0,1 1,4 0 a2,2 0,1 1,-4 0" android:fillColor="#9D4EDD" />
    <path android:pathData="M12,29 m-1.5,0 a1.5,1.5 0,1 1,3 0 a1.5,1.5 0,1 1,-3 0" android:fillColor="#7B2FBE" />
    <path android:pathData="M36,29 m-1.5,0 a1.5,1.5 0,1 1,3 0 a1.5,1.5 0,1 1,-3 0" android:fillColor="#7B2FBE" />

    <!-- Base platform -->
    <path
        android:pathData="M12,38 L36,38"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="38"
                android:endX="36"
                android:endY="38">
                <item android:offset="0.0" android:color="#FF7B2FBE" />
                <item android:offset="0.5" android:color="#FF9D4EDD" />
                <item android:offset="1.0" android:color="#FF00D4FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
