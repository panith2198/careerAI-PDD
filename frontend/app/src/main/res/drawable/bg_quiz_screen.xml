<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#090718"
                android:endColor="#03030B"
                android:startColor="#080816" />
        </shape>
    </item>
    <item android:gravity="top|end">
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:endColor="#001F0A44"
                android:startColor="#442E1065" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_grid" />
</layer-list>
