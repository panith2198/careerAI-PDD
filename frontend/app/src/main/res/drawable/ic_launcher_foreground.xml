<?xml version="1.0" encoding="utf-8"?>
<!-- AI Smart Career Navigator — Brand Foreground Logo
     Design: Upward-rising arrow (career growth) with AI circuit nodes
     representing the fusion of AI intelligence and career progression.
     Colors: Violet (#9D4EDD) primary stroke, Cyan (#00D4FF) AI accent nodes
     Centered in adaptive icon safe zone (24dp inset = 66x66 viewport) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- === MAIN UPWARD ARROW (Career Growth Path) === -->
    <!-- Central rising arrow shaft — thick, bold, representing career trajectory -->
    <path
        android:pathData="M54,28 L54,78"
        android:strokeWidth="4"
        android:strokeColor="#9D4EDD"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Arrow head pointing up — career ascent -->
    <path
        android:pathData="M42,42 L54,28 L66,42"
        android:strokeWidth="4"
        android:strokeColor="#9D4EDD"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- === AI CIRCUIT NETWORK (Intelligence Layer) === -->
    <!-- Left branch — branching path from main shaft -->
    <path
        android:pathData="M54,58 L38,50"
        android:strokeWidth="2.5"
        android:strokeColor="#00D4FF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Right branch — branching path from main shaft -->
    <path
        android:pathData="M54,58 L70,50"
        android:strokeWidth="2.5"
        android:strokeColor="#00D4FF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Lower left branch -->
    <path
        android:pathData="M54,68 L36,64"
        android:strokeWidth="2"
        android:strokeColor="#7B2FBE"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Lower right branch -->
    <path
        android:pathData="M54,68 L72,64"
        android:strokeWidth="2"
        android:strokeColor="#7B2FBE"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- === AI CIRCUIT NODES (Intelligence dots) === -->
    <!-- Main node at arrow tip (glow) -->
    <path
        android:pathData="M54,28 m-4,0 a4,4 0,1 1,8 0 a4,4 0,1 1,-8 0"
        android:fillColor="#9D4EDD" />

    <!-- Central junction node -->
    <path
        android:pathData="M54,58 m-3.5,0 a3.5,3.5 0,1 1,7 0 a3.5,3.5 0,1 1,-7 0"
        android:fillColor="#00D4FF" />

    <!-- Left node — cyan AI accent -->
    <path
        android:pathData="M38,50 m-3,0 a3,3 0,1 1,6 0 a3,3 0,1 1,-6 0"
        android:fillColor="#00D4FF" />

    <!-- Right node — cyan AI accent -->
    <path
        android:pathData="M70,50 m-3,0 a3,3 0,1 1,6 0 a3,3 0,1 1,-6 0"
        android:fillColor="#00D4FF" />

    <!-- Lower junction node -->
    <path
        android:pathData="M54,68 m-3,0 a3,3 0,1 1,6 0 a3,3 0,1 1,-6 0"
        android:fillColor="#9D4EDD" />

    <!-- Far left node -->
    <path
        android:pathData="M36,64 m-2.5,0 a2.5,2.5 0,1 1,5 0 a2.5,2.5 0,1 1,-5 0"
        android:fillColor="#7B2FBE" />

    <!-- Far right node -->
    <path
        android:pathData="M72,64 m-2.5,0 a2.5,2.5 0,1 1,5 0 a2.5,2.5 0,1 1,-5 0"
        android:fillColor="#7B2FBE" />

    <!-- === BASE PLATFORM (Foundation line) === -->
    <path
        android:pathData="M36,78 L72,78"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="78"
                android:endX="72"
                android:endY="78">
                <item android:offset="0.0" android:color="#7B2FBE" />
                <item android:offset="0.5" android:color="#9D4EDD" />
                <item android:offset="1.0" android:color="#00D4FF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>