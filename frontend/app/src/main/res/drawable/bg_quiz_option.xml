<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="0" android:endColor="#D3121026" android:startColor="#F0100F21" />
            <stroke android:width="1dp" android:color="#3D9D99B8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:width="42dp"
        android:height="42dp"
        android:gravity="start|center_vertical"
        android:left="12dp">
        <shape android:shape="oval">
            <solid android:color="#251D1A3D" />
            <stroke android:width="1dp" android:color="#665C5A78" />
        </shape>
    </item>
</layer-list>
