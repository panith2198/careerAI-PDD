<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Glowing Background -->
    <path
        android:pathData="M60,60m-50,0a50,50 0,1 1,100 0a50,50 0,1 1,-100 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="60"
                android:centerY="60"
                android:gradientRadius="45">
                <item android:color="#337C3AED" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Clipboard Board -->
    <path
        android:pathData="M25,28 h40 a4,4 0,0 1,4 4 v60 a4,4 0,0 1,-4 4 h-40 a4,4 0,0 1,-4 -4 v-60 a4,4 0,0 1,4 -4 Z"
        android:fillColor="#151230"
        android:strokeColor="#7C3AED"
        android:strokeWidth="1.5" />

    <!-- Clipboard Metal Clip -->
    <path
        android:pathData="M40,24 h10 a2,2 0,0 1,2 2 v4 h-14 v-4 a2,2 0,0 1,2 -2 Z"
        android:fillColor="#8B5CF6" />
    <path
        android:pathData="M42,20 h6 a1,1 0,0 1,1 1 v3 h-8 v-3 a1,1 0,0 1,1 -1 Z"
        android:fillColor="#A78BFA" />

    <!-- Checklist Items (Horizontal lines & checkmarks) -->
    <path
        android:pathData="M38,42 h20 M38,54 h20 M38,66 h20"
        android:strokeColor="#9D99B8"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Checkmarks -->
    <path
        android:pathData="M30,42 l2,2 l4,-4 M30,54 l2,2 l4,-4 M30,66 l2,2 l4,-4"
        android:fillColor="#00000000"
        android:strokeColor="#0891B2"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Target Board (Right side overlay) -->
    <path
        android:pathData="M80,75m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0"
        android:fillColor="#18143C"
        android:strokeColor="#8B5CF6"
        android:strokeWidth="2" />
    <path
        android:pathData="M80,75m-15,0a15,15 0,1 1,30 0a15,15 0,1 1,-30 0"
        android:fillColor="#251C5C"
        android:strokeColor="#A78BFA"
        android:strokeWidth="1.5" />
    <path
        android:pathData="M80,75m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0"
        android:fillColor="#0891B2" />
    <path
        android:pathData="M80,75m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0"
        android:fillColor="#FFFFFF" />

    <!-- Dart Arrow (Piercing the target from top-right to center) -->
    <path
        android:pathData="M98,53 L82,73"
        android:strokeColor="#0891B2"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
    <!-- Dart Fletching -->
    <path
        android:pathData="M96,51 L102,48 L100,56 Z"
        android:fillColor="#E11D48" />
    <!-- Dart Tip -->
    <path
        android:pathData="M80,75 L84,72 L82,76 Z"
        android:fillColor="#FFFFFF" />
</vector>
