<?xml version="1.0" encoding="utf-8"?>
<!--
    AI Smart Career Navigator — Dark Theme Color Tokens
    Design System v2.0 | "Deep Space Intelligence"
    Palette: Violet + Black + Slate + White axis ONLY
    ⚠ NO yellow · NO amber · NO gold anywhere in this file
    Usage: place in res/values-night/colors.xml
-->
<resources>

    <!-- ═══════════════════════════════════════════════════════
         BASE SURFACES
         Four distinct blacks — never the same shade twice.
         Elevation is communicated through surface tinting,
         not drop shadows.
         ═══════════════════════════════════════════════════════ -->

    <!-- Deepest base layer — screen background -->
    <color name="color_background">#060608</color>

    <!-- Ink black — toolbar, bottom nav, app bar -->
    <color name="color_surface_1">#0F0F1C</color>

    <!-- Slate black — default card / list item surface -->
    <color name="color_surface_2">#161525</color>

    <!-- Deep slate — elevated card, bottom sheet, modal -->
    <color name="color_surface_3">#1E1B2E</color>

    <!-- Lifted slate — highest elevation, FAB tray, dropdown -->
    <color name="color_surface_4">#2D2A42</color>

    <!-- 3% white glass overlay — glassmorphism cards -->
    <color name="color_surface_glass">#08FFFFFF</color>

    <!-- 8% white glass overlay — stronger glass treatment -->
    <color name="color_surface_glass_strong">#14FFFFFF</color>


    <!-- ═══════════════════════════════════════════════════════
         VIOLET BRAND PALETTE
         Core brand heartbeat — #6D28D9 → #A78BFA gradient.
         Use on CTAs, active states, AI features, accents.
         ═══════════════════════════════════════════════════════ -->

    <!-- Core violet — primary brand color -->
    <color name="color_primary">#6D28D9</color>

    <!-- Active / hover / selected violet -->
    <color name="color_primary_bright">#8B5CF6</color>

    <!-- Neon violet — glow, emphasis, score highlights -->
    <color name="color_primary_glow">#A78BFA</color>

    <!-- Deep violet — pressed state, muted variant -->
    <color name="color_primary_muted">#4C1D95</color>

    <!-- 15% violet tint — chip/badge backgrounds -->
    <color name="color_primary_dim">#266D28D9</color>

    <!-- 20% violet tint — stronger tinted backgrounds -->
    <color name="color_primary_dim_strong">#338B5CF6</color>

    <!-- Very dark violet container — section backgrounds -->
    <color name="color_primary_container">#2E1065</color>

    <!-- Text on violet/primary surfaces -->
    <color name="color_on_primary">#FFFFFF</color>


    <!-- ═══════════════════════════════════════════════════════
         CYAN ACCENT
         Reserved EXCLUSIVELY for AI features and live status.
         Do NOT use cyan anywhere else in the UI.
         ═══════════════════════════════════════════════════════ -->

    <!-- AI streaming, live indicator, chat cursor -->
    <color name="color_cyan">#22D3EE</color>

    <!-- 10% cyan — AI message bubble background -->
    <color name="color_cyan_dim">#1A22D3EE</color>

    <!-- Cyan card border — AI response cards -->
    <color name="color_cyan_border">#3322D3EE</color>


    <!-- ═══════════════════════════════════════════════════════
         SEMANTIC STATUS COLORS
         Minimal palette. No warm tones — violet replaces amber.
         ═══════════════════════════════════════════════════════ -->

    <!-- Success — verified, completed, correct answer, pass -->
    <color name="color_emerald">#10B981</color>
    <color name="color_emerald_dim">#2010B981</color>

    <!-- Error / Danger — rejected, wrong answer, destructive -->
    <color name="color_rose">#F43F5E</color>
    <color name="color_rose_dim">#20F43F5E</color>

    <!-- Warning — uses mid-violet, NOT amber or yellow -->
    <color name="color_violet_warning">#7C3AED</color>
    <color name="color_violet_warning_dim">#267C3AED</color>

    <!-- Semantic aliases — map to above tokens -->
    <color name="color_success">#10B981</color>
    <color name="color_success_bg">#2010B981</color>
    <color name="color_warning">#7C3AED</color>
    <color name="color_warning_bg">#207C3AED</color>
    <color name="color_error">#F43F5E</color>
    <color name="color_error_bg">#20F43F5E</color>
    <color name="color_info">#22D3EE</color>
    <color name="color_info_bg">#2022D3EE</color>

    <!-- Legacy aliases — remapped to monochrome system -->
    <!-- color_amber was #F59E0B — now remapped to violet warning -->
    <color name="color_amber">#7C3AED</color>
    <color name="color_amber_dim">#267C3AED</color>
    <!-- color_gold was #F59E0B — now remapped to bright violet -->
    <color name="color_gold">#8B5CF6</color>
    <color name="color_gold_dim">#268B5CF6</color>
    <!-- Indigo — analytics, secondary data -->
    <color name="color_indigo">#6366F1</color>


    <!-- ═══════════════════════════════════════════════════════
         TEXT COLORS
         Violet-tinted greyscale axis — NOT pure white/grey.
         All shades carry a subtle violet warmth.
         ═══════════════════════════════════════════════════════ -->

    <!-- Primary text — near-white with violet warmth -->
    <color name="color_text_primary">#EEEAF8</color>

    <!-- Secondary text — muted violet-grey, metadata, labels -->
    <color name="color_text_secondary">#9D99B8</color>

    <!-- Tertiary text — placeholder, disabled, hint text -->
    <color name="color_text_tertiary">#5C5A78</color>

    <!-- Inverse text — for light surfaces -->
    <color name="color_text_inverse">#060608</color>

    <!-- Violet callout text — links, highlights, annotations -->
    <color name="color_text_violet">#C4B5FD</color>


    <!-- ═══════════════════════════════════════════════════════
         BORDER & DIVIDER TOKENS
         All neutral alpha-white — no tinted borders as defaults.
         ═══════════════════════════════════════════════════════ -->

    <!-- 6% white — default card border, input box -->
    <color name="color_border">#10FFFFFF</color>

    <!-- 10% white — medium emphasis border -->
    <color name="color_border_medium">#1AFFFFFF</color>

    <!-- 15% white — high emphasis border, focused card -->
    <color name="color_border_strong">#26FFFFFF</color>

    <!-- Violet-tinted border — focused input, active card -->
    <color name="color_border_violet">#308B5CF6</color>

    <!-- Ultra-subtle section divider line -->
    <color name="color_divider">#08FFFFFF</color>


    <!-- ═══════════════════════════════════════════════════════
         SPECIAL TOKENS
         ═══════════════════════════════════════════════════════ -->

    <!-- Dialog / bottom sheet scrim, 80% black -->
    <color name="color_overlay_scrim">#CC000000</color>

    <!-- Violet glow shadow — for elevated violet cards -->
    <color name="color_shadow_violet">#666D28D9</color>

    <!-- Ripple on violet/primary surfaces -->
    <color name="color_ripple_primary">#288B5CF6</color>

    <!-- Ripple on white/light surfaces -->
    <color name="color_ripple_white">#14FFFFFF</color>


    <!-- ═══════════════════════════════════════════════════════
         GRADIENT REFERENCE STOPS
         Use in GradientDrawable / ShapeDrawable in code.
         ═══════════════════════════════════════════════════════ -->
    <!--
        Primary button gradient  : #6D28D9 → #8B5CF6 → #A78BFA  (135°)
        Glow gradient            : #8B5CF640 → transparent
        Deep gradient            : #060608 → #1A0A2E
        Slate gradient           : #0F0F1C → #2D2A42
        Career banner gradient   : #1A0A2E → #0F0F1C
        Success gradient         : #064E3B → #10B981
        Error gradient           : #881337 → #F43F5E
        Roadmap Foundation bar   : #6D28D9 → #8B5CF6
        Roadmap Intermediate bar : #2D2A42 → #6D28D9
        Roadmap Advanced bar     : #8B5CF6 → #A78BFA
        Timer safe gradient      : #6D28D9 → #22D3EE
        Timer danger gradient    : #7C3AED → #F43F5E
    -->

</resources>