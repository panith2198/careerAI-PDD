<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AiCareer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/color_cyan</item>
        <item name="colorOnSecondary">@color/color_on_primary</item>

        <!-- Surface -->
        <item name="colorSurface">@color/color_surface_2</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorOnBackground">@color/color_text_primary</item>

        <!-- Outlines and Borders -->
        <item name="colorOutline">@color/color_border</item>
        <item name="colorOutlineVariant">@color/color_border_medium</item>

        <!-- Dropdown / Popup styling -->
        <item name="android:popupBackground">@drawable/bg_card_resting</item>

        <!-- Error -->
        <item name="colorError">@color/color_rose</item>
        <item name="colorOnError">@color/color_on_primary</item>

        <!-- Shape Appearances -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance_AiCareer_Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance_AiCareer_Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance_AiCareer_Large</item>

        <!-- System Traits -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/color_surface_1</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Ripples -->
        <item name="android:colorControlHighlight">@color/color_ripple_primary</item>

        <!-- Disable yellow autofill background highlight app-wide -->
        <item name="android:autofilledHighlight">@android:color/transparent</item>


    </style>

    <!-- Deprecated name fallback link to avoid build issues before manifest is updated -->
    <style name="Theme.CarrerAI" parent="Theme.AiCareer" />
</resources>