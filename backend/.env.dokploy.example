APP_NAME="AI Smart Career Navigator"
APP_ENV=production
DEBUG=false

SECRET_KEY="replace-with-a-long-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Use the internal Dokploy database service hostname, not the public API domain.
DATABASE_URL="mysql+aiomysql://careerai_user:replace-password@careerai-db:3306/careerai"
REDIS_URL="redis://careerai-redis:6379/0"

MISTRAL_API_KEY="replace-with-mistral-api-key"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="replace-with-email"
SMTP_PASSWORD="replace-with-app-password"
SMTP_FROM="replace-with-email"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
