# ==========================================
# CareerAI Core Application Settings
# ==========================================
APP_NAME="AI Smart Career Navigator"
APP_ENV="development"
DEBUG=true

# ==========================================
# Security & Session Authentication (JWT)
# ==========================================


SECRET_KEY="supersecretkeyforlocaldevelopmentcareerainavigator"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# Relational Database Configuration (MySQL)
# ==========================================
# For async connection, we utilize the aiomysql driver
DATABASE_URL="mysql+aiomysql://root:@localhost:3306/careerai"

# ==========================================
# Memory Cache & Celery Task Broker (Redis)
# ==========================================

REDIS_URL="redis://localhost:6379/0"

# ==========================================
# External AI & RAG Integrations
# ==========================================

MISTRAL_API_KEY="BZpIz87SrkU6WA9q0V1Y5RGFiTVVaeKN"

# ==========================================
# Vector Storage Configurations (ChromaDB)
# ==========================================

CHROMA_PERSIST_DIR="../database/vector_data"


# ==========================================
# Telemetry, Monitoring & Logging
# ==========================================

PROMETHEUS_METRICS_ENABLED=true
SENTRY_DSN=""
LOG_LEVEL="INFO"



# ==========================================
# SMTP / EMAIL Configuration
# ==========================================
